# FreeAI TLS gateway (compose --profile tls)
# Default: internal (self-signed) cert on :8443 - fine for LAN/tailnet.
# For a PUBLIC domain with automatic HTTPS (ACME/Let's Encrypt):
#   1. mount docker/Caddyfile.public instead of this file
#   2. set FREEAI_DOMAIN + ACME_EMAIL (+ publish ports 80/443)
#
# Autonomous API auth: AUTOAUTH_USER / AUTOAUTH_HASH (bcrypt) - REQUIRED.
#   generate a hash:  docker run --rm caddy caddy hash-password --plaintext 'yourpw'
#   Set AUTOAUTH_HASH in .env before starting the TLS profile.
{
	admin off
}

:8443 {
	# ---- Dashboard (public surface) ----
	# Settings writes stay LAN/tailnet-only even through TLS.
	handle /api/settings* {
		@post method POST
		respond @post 403 "write via LAN/tailnet only" 403
		reverse_proxy dashboard:8030
	}

	# ---- Autonomous SDLC API (basic-auth protected) ----
	handle /auto/* {
		basic_auth {
			{$AUTOAUTH_USER:freeai} {$AUTOAUTH_HASH}
		}
		reverse_proxy autonomous:8050
	}

	# ---- everything else -> dashboard ----
	handle {
		reverse_proxy dashboard:8030
	}
}

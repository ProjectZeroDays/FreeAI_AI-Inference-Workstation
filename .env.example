# Copy to .env and adjust. Used by docker compose.

# ==============================================================================
# CORE SERVICES
# ==============================================================================

# --- Ports (all overridable) ---
ROUTER_PORT=8010
AGENT_API_PORT=8020
DASHBOARD_PORT=8030
WORKFLOW_PORT=8040
AUTONOMOUS_PORT=8050
LLAMA_PORT=9001
VLLM_PORT=9002
FREETOKEN_PORT=9100

# --- vLLM ---
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
N_GPU_LAYERS=80

# --- llama.cpp extras (e.g. draft model for speculative decoding) ---
LLAMA_EXTRA_ARGS=
LLAMA_VISION_ENABLED=false
LLAMA_MMPROJ_PATH=

# --- Second llama shard (hot-model swap) ---
LLAMA2_MODEL_PATH=/models/Qwen3.5-9B-Claude-Code-Q4_K_M.gguf
LLAMA2_VISION_ENABLED=false
LLAMA2_MMPROJ_PATH=
LLAMA2_GPU=1

# --- Router security / behavior ---
# SECURITY WARNING: ROUTER_API_KEY must be set to a strong random value in production.
# Leaving it empty will cause the router to reject all requests (fail-secure).
# Generate a secure key: openssl rand -hex 32
# Example: ROUTER_API_KEY=a1b2c3d4e5f6...
ROUTER_API_KEY=
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_MIN=60
CACHE_ENABLED=true
CACHE_SIZE=128
MOCK_LLM=0
LLAMA_BASE=http://localhost:9001

# --- Agent API ---
AGENT_API_KEY=
AGENT_MODEL_OVERRIDES={}
AGENT_PROFILE=balanced

# --- Environment profile hint (dev|staging|prod) ---
STACK_PROFILE=dev

# ==============================================================================
# TLS GATEWAY (--profile tls)
# ==============================================================================
# REQUIRED: Generate a bcrypt hash for autonomous API authentication
#   docker run --rm caddy caddy hash-password --plaintext 'your-secure-password'
# The TLS profile will fail to start if AUTOAUTH_HASH is not set.
AUTOAUTH_USER=freeai
AUTOAUTH_HASH=
FREEAI_DOMAIN=
ACME_EMAIL=

# ==============================================================================
# GPU INFERENCE
# ==============================================================================

# --- FreeToken (edge MoE serving, --profile freetoken) ---
FREETOKEN_MODEL=deepseek-ai/DeepSeek-V4-Flash
FREETOKEN_BASE_URL=

# ==============================================================================
# EXTERNAL AI PROVIDERS
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
NOVITA_API_KEY=
DEEPINFRA_API_KEY=
HYPERBOLIC_API_KEY=
HF_TOKEN=

# ==============================================================================
# HERMES INTEGRATION
# ==============================================================================
HERMES_PORT=8090
HERMES_ENABLED=true
HERMES_API_KEY=

# ==============================================================================
# SALAD INTEGRATION
# ==============================================================================
SALAD_API_KEY=
SALAD_GPU_ID=

# ==============================================================================
# AIKIDO INTEGRATION
# ==============================================================================
AIKIDO_API_KEY=
AIKIDO_APP_ID=

# ==============================================================================
# SCHEDULER
# ==============================================================================
SCHEDULER_MAX_JOBS=5
SCHEDULER_TIMEZONE=UTC

# ==============================================================================
# AUTONOMOUS SDLC
# ==============================================================================
ENABLE_SHELL_TOOLS=0
MAX_FIX_ROUNDS=3
SHELL_TIMEOUT_S=120
WORKSPACES_DIR=workspaces
MAX_FILE_BYTES=524288
MAX_CONCURRENT_RUNS=3

# ==============================================================================
# RESOURCE OPTIMIZER
# ==============================================================================
OPTIMIZER_INTERVAL_S=60
COOLDOWN_S=600
GPU_ID=0
GPU_POWER_LIMIT_W=240
GPU_LOCKED_CLOCK_MHZ=2520

# ==============================================================================
# MCP REGISTRY
# ==============================================================================
MCP_REGISTRY_ENABLED=true
MCP_SERVERS_DIR=mcp/servers
MCP_PORT=8090
MCP_API_KEY=

# ==============================================================================
# MEMORY / RAG
# ==============================================================================
QDRANT_URL=http://localhost:6333
MEMORY_MAX_TURNS=50
MEMORY_MAX_SESSIONS=500
MEMORY_SESSION_TTL=604800
MEMORY_SUMMARIZE_AFTER=30

# ==============================================================================
# BROWSER
# ==============================================================================
BROWSER_PORT=8180
GHIDRA_HOME=
FRIDA_DIR=

# ==============================================================================
# PIPELINE / PROXY
# ==============================================================================
PROXY_URL=http://localhost:8100/proxy
PROXY_PORT=8100
PROXY_URL_INTERNAL=http://localhost:8100
ROUTER_URL=http://localhost:8010/route
WORKFLOW_API=http://localhost:8040
AUTO_API=http://localhost:8050
DASH_API=http://localhost:8030

# ==============================================================================
# SPECIALIZED AGENTS (Red/Blue/Purple Team)
# ==============================================================================
REDTEAM_MODEL=qwen3.6-12b
REDTEAM_PROFILE=creative
BLUETEAM_MODEL=qwythos-v2-9b
PURPLETEAM_MODEL=moe-13b
ORCHESTRATOR_MODEL=anthropic/claude-opus-4-6
EXPLORER_MODEL=google/gemini-2.5-flash
ORACLE_MODEL=anthropic/claude-opus-4-6
COUNCIL_MODEL=multi
LIBRARIAN_MODEL=google/gemini-2.5-flash
DESIGNER_MODEL=anthropic/claude-sonnet-4-5
FIXER_MODEL=deepseek/deepseek-chat

# ==============================================================================
# AGENT TOOLKIT
# ==============================================================================
AGENT_TOOLKIT_SKILLS=

# ==============================================================================
# DASHBOARD
# ==============================================================================
DASHBOARD_AUTH_TOKEN=
UPLOAD_DIR=

# ==============================================================================
# WORKFLOW ENGINE
# ==============================================================================
WORKFLOW_AUDIT_LOG=logs/workflow-audit.jsonl
WORKFLOW_STEP_RETRIES=3
WORKFLOW_RETRY_DELAY_S=2

# ==============================================================================
# LOAD BALANCER
# ==============================================================================
LB_STRATEGY=round_robin

# ==============================================================================
# GODMODE / RED TEAM
# ==============================================================================
GODMODE_ENABLED=true
ARMY_SIZE=10

# ==============================================================================
# SECURITY
# ==============================================================================
PERMISSIONS_ENGINE_ENABLED=true
SANDBOX_ENABLED=true
CAMPAIGN_ENABLED=true

# ==============================================================================
# SERVICE PORTS (microservices)
# ==============================================================================
PROXY_PORT=8100
MEMORY_PORT=8110
AGENTS_PORT=8120
REGISTRY_PORT=8130
RAG_PORT=8140
BRAIN_PORT=8150
SKILLS_PORT=8160
PIPELINE_PORT=8170

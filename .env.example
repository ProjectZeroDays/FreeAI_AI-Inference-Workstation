# Copy to .env and adjust. Used by docker compose.

# --- vLLM ---
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
N_GPU_LAYERS=80

# --- llama.cpp extras (e.g. draft model for speculative decoding) ---
LLAMA_EXTRA_ARGS=

# --- Router security / behavior ---
ROUTER_API_KEY=
RATE_LIMIT_CAPACITY=60
CACHE_ENABLED=true
MOCK_LLM=0

# --- Environment profile hint (dev|staging|prod) ---
STACK_PROFILE=dev

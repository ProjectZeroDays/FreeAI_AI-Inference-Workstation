{
  "$id": "config.json",
  "type": "object",
  "properties": {
    "router": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "api_key": {"type": "string"},
        "rate_limit_capacity": {"type": "integer", "minimum": 1},
        "rate_limit_refill_per_min": {"type": "integer", "minimum": 1},
        "cache_enabled": {"type": "boolean"},
        "cache_size": {"type": "integer", "minimum": 1},
        "backend_timeout_s": {"type": "integer", "minimum": 1},
        "mock_llm": {"type": "boolean"},
        "model_overrides": {"type": "object"}
      },
      "required": ["port"]
    },
    "agents": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "default_profile": {"type": "string"},
        "memory_max_turns": {"type": "integer", "minimum": 1}
      },
      "required": ["port"]
    },
    "workflow": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "audit_log": {"type": "string"},
        "step_retries": {"type": "integer", "minimum": 0},
        "retry_delay_s": {"type": "number", "minimum": 0}
      },
      "required": ["port"]
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "gpu_temp_alert_c": {"type": "integer"},
        "gpu_util_alert_pct": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "required": ["port"]
    }
  },
  "required": ["router", "agents", "workflow", "dashboard"]
}

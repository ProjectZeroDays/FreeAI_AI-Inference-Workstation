{
  "$id": "presets.json",
  "type": "object",
  "properties": {
    "presets": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "type": "object",
          "properties": {
            "model": {"type": "string"},
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "max_tokens": {"type": "integer", "minimum": 1},
            "description": {"type": "string"}
          }
        }
      }
    },
    "active": {"type": "string"},
    "overrides": {"type": "object"},
    "updated": {"type": "string"}
  }
}

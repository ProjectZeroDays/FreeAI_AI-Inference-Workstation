{
  "$id": "scheduler.json",
  "type": "object",
  "properties": {
    "_comment": {"type": "string"},
    "scheduler": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "max_concurrent_jobs": {"type": "integer", "minimum": 1},
        "default_cron": {"type": "string"},
        "timezone": {"type": "string"},
        "retry_policy": {
          "type": "object",
          "properties": {
            "max_retries": {"type": "integer", "minimum": 0},
            "backoff_base": {"type": "integer", "minimum": 1},
            "backoff_max": {"type": "integer", "minimum": 1}
          }
        },
        "notifications": {
          "type": "object",
          "properties": {
            "on_success": {"type": "boolean"},
            "on_failure": {"type": "boolean"},
            "channels": {"type": "array", "items": {"type": "string"}}
          }
        },
        "services": {"type": "object"}
      },
      "required": ["enabled"]
    }
  }
}

{
  "campaign_examples": [
    {
      "campaign_id": "CAMP-20260831-001",
      "type": "ab_test",
      "title": "Phishing Template Effectiveness - IT Staff Segment",
      "description": "Test urgency vs authority-based phishing templates against IT personnel",
      "created": "2026-08-31T10:00:00Z",
      "status": "draft",
      "variants": [
        {
          "id": "variant_1",
          "name": "Urgency-Based",
          "weight": 50,
          "payload": {
            "subject": "URGENT: Password Expiration Notice - Action Required Within 24 Hours",
            "body_template": "password_expiration_warning",
            "cta_text": "Reset Password Now",
            "urgency_indicators": ["countdown_timer", "red_alert_banner", "bold_text"]
          }
        },
        {
          "id": "variant_2",
          "name": "Authority-Based",
          "weight": 50,
          "payload": {
            "subject": "IT Security Team: Mandatory Credential Update Required",
            "body_template": "mandatory_security_update",
            "cta_text": "Apply Security Update",
            "authority_indicators": ["IT_logo", "reference_number", "department_stamp"]
          }
        }
      ],
      "audience": {
        "segment": "it_staff",
        "sample_size": 100,
        "criteria": ["department=IT", "title_contains_admin"],
        "min_confidence": 0.95
      },
      "metrics": ["open_rate", "click_rate", "credential_submission", "report_rate"],
      "duration_hours": 24,
      "budget": {
        "total": 500,
        "currency": "test_credits",
        "per_variant": 250
      },
      "expected_outcomes": {
        "urgency_variant": {
          "target_open_rate": 0.75,
          "target_click_rate": 0.45,
          "target_submission": 0.15
        },
        "authority_variant": {
          "target_open_rate": 0.80,
          "target_click_rate": 0.38,
          "target_submission": 0.12
        }
      }
    },
